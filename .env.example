APP_ENV=local
APP_DEBUG=true

# URL base pública del backend (para construir URLs de archivos subidos).
APP_URL=http://localhost:8000

# Orígenes permitidos por CORS, separados por comas. Admite un comodín "*"
# por entrada (p. ej. https://*.vercel.app para los despliegues preview).
CORS_ALLOWED_ORIGIN=http://localhost:5173,https://revista-cavite.vercel.app,https://*.vercel.app

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=revista_cavite
DB_USERNAME=root
DB_PASSWORD=

# Horas de validez de un token de sesión.
TOKEN_TTL_HOURS=720
