APP_ENV=local
APP_DEBUG=true

# URL base pública del backend (para construir URLs de archivos subidos).
APP_URL=http://localhost:8000

# Origen exacto permitido por CORS (el frontend Vite en local).
CORS_ALLOWED_ORIGIN=http://localhost:5173

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=revista_cavite
DB_USERNAME=root
DB_PASSWORD=

# Horas de validez de un token de sesión.
TOKEN_TTL_HOURS=720
